{
  "opencollection": "1.0.0",
  "info": {
    "name": "ScyllaDB Cloud Account Cluster API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
