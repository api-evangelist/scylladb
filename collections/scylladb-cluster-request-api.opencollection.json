{
  "opencollection": "1.0.0",
  "info": {
    "name": "ScyllaDB Cloud Account Cluster Request API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cluster Request",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the list of cluster requests created in context of given account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/account/:accountId/cluster/:clusterId/request",
            "headers": [
              {
                "name": "traceparent",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "Account ID"
              },
              {
                "name": "clusterId",
                "value": "",
                "type": "path",
                "description": "Cluster ID"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "type of request"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "status of request"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return the list of cluster requests created in the context of a given account."
        },
        {
          "info": {
            "name": "Get the details about cluster request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/account/:accountId/cluster/request/:requestId",
            "headers": [
              {
                "name": "traceparent",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "Account ID"
              },
              {
                "name": "requestId",
                "value": "",
                "type": "path",
                "description": "RequestId"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return details about a particular cluster request."
        }
      ]
    }
  ],
  "bundled": true
}